# Copy to .env before packaging. Baked in at build time (MAIN_VITE_* → main process).
# Without these the Account page says the build has no account service.
#
# Local dev:
MAIN_VITE_BUDDY_API_URL=http://127.0.0.1:8787
MAIN_VITE_SUPABASE_URL=https://updates.thebuddyassistant.com/rest/v1/
MAIN_VITE_SUPABASE_ANON_KEY=
#
# Production dmg (set in CI or locally, then npm run release -w buddy):
# MAIN_VITE_BUDDY_API_URL=https://api.thebuddyassistant.com
# MAIN_VITE_SUPABASE_URL=https://<project>.supabase.co
# MAIN_VITE_SUPABASE_ANON_KEY=<anon key>
#
# Publishing (shell env, not this file): GH_TOKEN with write access to
# Point-Click-Technologies/buddy-releases. The feed is build.publish in package.json.
